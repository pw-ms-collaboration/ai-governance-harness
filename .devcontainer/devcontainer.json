{
  "name": "AI Governance Harness",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "containerEnv": {
    "PIP_DISABLE_PIP_VERSION_CHECK": "1",
    "PIP_INDEX_URL": "${localEnv:PIP_INDEX_URL:https://pypi.org/simple/}",
    "UV_DEFAULT_INDEX": "${localEnv:UV_DEFAULT_INDEX:https://pypi.org/simple/}",
    "NPM_CONFIG_REGISTRY": "${localEnv:NPM_CONFIG_REGISTRY:https://registry.npmjs.org/}"
  },
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1.3.0": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python"
      ]
    }
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install --editable '.[dev]'",
  "forwardPorts": [
    8001,
    8080
  ],
  "portsAttributes": {
    "8001": {
      "label": "MCP server",
      "onAutoForward": "silent"
    },
    "8080": {
      "label": "Chat UI",
      "onAutoForward": "openBrowser"
    }
  }
}