# Azure Entra / Tenant Settings
AZURE_TENANT_ID=<your-foundry-tenant-id>

# Azure Subscription & Resource Coordinates
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=<your-resource-group>
AZURE_AI_PROJECT_NAME=<your-project-name>

# Option A: Full project connection string (found in Azure AI Foundry project overview)
# Format: <region>.api.azureml.ms;<subscription-id>;<resource-group>;<project-name>
AZURE_AI_PROJECT_CONNECTION_STRING=

# Option B: Direct project endpoint URL (if using Azure AI Foundry / Projects client)
# Format: https://<project-endpoint>.services.ai.azure.com/api/projects/<project-id>
AZURE_AI_PROJECT_ENDPOINT=<your-project-endpoint>
AZURE_AI_PROJECT_REGION=australiaeast

# Authentication (Optional: Only if using a Service Principal instead of az login)
# AZURE_CLIENT_ID=<service-principal-client-id>
# AZURE_CLIENT_SECRET=<service-principal-client-secret>

# Model deployment name in your Foundry project
AZURE_AI_MODEL_DEPLOYMENT_NAME=<your-model-deployment-name>
AZURE_AI_EVALUATOR_REGISTRY=<verified-behavior-registration-directory>
AZURE_AI_EVAL_JUDGE_DEPLOYMENT_NAME=<your-judge-deployment-name>

# Local MCP and chat services
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_PATH=/mcp
MCP_JSON_RESPONSE=false

MCP_SERVER_URL=http://127.0.0.1:8001/mcp
CHAT_HOST=127.0.0.1
CHAT_PORT=8080

# Local mock identity only. Synthetic IDs, not Entra resources or credentials.
# Never enable outside local/development/test or on a hosted service.
# ai-governance-dev derives these settings automatically for its children.
MOCK_IDENTITY_ENABLED=true
MOCK_IDENTITY_HOST=127.0.0.1
MOCK_IDENTITY_PORT=8002
MCP_ENVIRONMENT=local
MCP_HOSTED=false
MCP_PRINCIPAL_SOURCE=jwt
MCP_JWT_ISSUER=http://127.0.0.1:8002/00000000-0000-4000-8000-000000000001/v2.0
MCP_JWT_JWKS_URL=http://127.0.0.1:8002/00000000-0000-4000-8000-000000000001/discovery/v2.0/keys
MCP_AUTH_TENANT_ID=00000000-0000-4000-8000-000000000001
MCP_AUTH_AUDIENCE=00000000-0000-4000-8000-000000000004
MCP_AUTH_REQUIRED_SCOPE=Tools.Read
AGENT_ID_INTERACTIVE_ID=00000000-0000-4000-8000-000000000005
AGENT_ID_REPORTING_ID=00000000-0000-4000-8000-000000000006
AGENT_ID_SIDECAR_URL=http://127.0.0.1:8002
# Token-less stdio/CLI only: analyst, retention_specialist,
# compliance_reviewer, administrator. Unset means deny.
# MOCK_IDENTITY_LOCAL_PERSONA=retention_specialist
# Hosted MCP uses easy_auth instead; it requires tenant, audience, scope,
# both agent IDs, an approved Azure region, and MCP_RESOURCE_URL.
# Hosted validation against real Entra Agent ID is deferred.

# Optional Azure Monitor export for chat/MCP explicit spans and metrics.
# Automatic HTTP/header capture and root logs are disabled; the mock issuer
# does not export. Never commit a real connection string.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Optional local UI history reader: Application ID (not instrumentation key).
# Requires az login and query/read access to this Application Insights resource.
APPLICATIONINSIGHTS_APP_ID=
# Corporate TLS proxy users can point requests at an approved PEM CA bundle.
# REQUESTS_CA_BUNDLE=/absolute/path/to/approved-ca-bundle.pem
# Observability cost estimates. Foundry reports tokens, not cost; defaults are
# GPT-5 Global Standard list prices per 1M tokens. Set your contracted rates.
# GENAI_PRICE_CURRENCY=USD
# GENAI_PRICE_INPUT_PER_1M=1.25
# GENAI_PRICE_CACHED_INPUT_PER_1M=0.125
# GENAI_PRICE_OUTPUT_PER_1M=10.0

# Mandatory local governance boundary
GOVERNANCE_ENABLED=true
GOVERNANCE_ENVIRONMENT=local
GOVERNANCE_AGENT_ID=ai-governance-harness
# Leave unset to use the policy packaged with the application.
# GOVERNANCE_POLICY_PATH=src/ai_governance_harness/governance/policies/default.yaml
GOVERNANCE_OPERATION_TIMEOUT_SECONDS=30
GOVERNANCE_CIRCUIT_FAILURE_THRESHOLD=3
GOVERNANCE_CIRCUIT_RECOVERY_SECONDS=30
GOVERNANCE_SANDBOX_PROVIDER=none
